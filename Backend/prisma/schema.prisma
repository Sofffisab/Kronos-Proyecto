generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persona {
  id        Int      @id @default(autoincrement())
  mail     String   @unique
  nombre  String
  contrasenia  String
  usuario  String   @unique
  foto_perfil   Bytes?
  horario_inicio        DateTime? @db.Time 
  horario_fin           DateTime? @db.Time

  archivos        archivos[]
  mensajes        mensajes[]
  personalizaciones personalizaciones[]
  proyectos_tiene tiene[]
  chat_tiene tiene_pc[]
  leido_mensajes     leido[] 

  googleRefreshToken String?

  tareas_responsable    tareas[] @relation("TareaResponsable")
  tareas_asignadas      tareas[] @relation("TareaAsignado")
}

model archivos {
  formato  String
  archivo   Bytes
  nombrearchivo   String    
  id    Int     @id @default(autoincrement())
  id_persona  Int
  id_proyecto   Int

  persona       persona  @relation(fields: [id_persona], references: [id])
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id])

  @@unique([nombrearchivo, id_proyecto])
}

model mensajes {
  id_chat   Int
  id_persona    Int
  mensaje   String
  estado    String
  id    Int     @id @default(autoincrement())
  fecha_envio DateTime @default(now())

  chat          chat     @relation(fields: [id_chat], references: [id])
  persona       persona  @relation(fields: [id_persona], references: [id])
  leidopor leido[]
}

model tareas {
  nombre    String
  estado    String
  id    Int    @id @default(autoincrement())
  id_proyecto   Int
  id_persona    Int
  id_responsable  Int?
  nombre_responsable  String?
  limite      DateTime
  eventId   String?
  // estos dos hay que hacer cuentas para la logistica de manejo default
  importancia         String?  
  orden               Int?

  responsable         persona?  @relation("TareaResponsable", fields: [id_responsable], references: [id])
  asignado            persona  @relation("TareaAsignado", fields: [id_persona], references: [id])
  proyecto            proyecto @relation(fields: [id_proyecto], references: [id])
}

model personalizaciones {
  id    Int     @id @default(autoincrement())
  id_persona    Int
  codigo_a_insertar   String

  persona             persona  @relation(fields: [id_persona], references: [id])
}

model tiene {
  id        Int      @id @default(autoincrement())
  id_persona  Int 
  id_proyecto   Int

  persona       persona  @relation(fields: [id_persona], references: [id])
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id])
  @@unique([id_persona, id_proyecto])
}

model proyecto {
  id        Int      @id @default(autoincrement())
  nombre     String   
  limite     DateTime
  descripcion String?
  fechaInicio DateTime @default(now())
  fechaFin DateTime?
  creadorId Int
  foto_perfil   Bytes?
  oficio    String?

  archivos        archivos[]
  tareas          tareas[]
  personas_tiene  tiene[]
  chats           chat[]
  invitaciones    invitaciones[]
  chats_tiene_rc  tiene_rc[]
}

model invitaciones {
  id        Int      @id @default(autoincrement())
  id_proyecto Int
  mail      String
  codigo    String   @unique
  estado    String
  fechaEnvio DateTime @default(now())
  fechaExpiracion DateTime

  proyecto  proyecto @relation(fields: [id_proyecto], references: [id])
}

model chat {
  id        Int      @id @default(autoincrement())
  nombre     String   

  id_proyecto   Int
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id])
  mensajes      mensajes[]
  personas_tiene  tiene_pc[]
  tiene_rc      tiene_rc[]
}

model tiene_pc {
  id         Int      @id @default(autoincrement())
  id_persona Int
  id_chat    Int
  
  persona    persona  @relation(fields: [id_persona], references: [id])
  chat       chat     @relation(fields: [id_chat], references: [id])
  @@unique([id_persona, id_chat])
}

model tiene_rc {
  id          Int      @id @default(autoincrement())
  id_proyecto Int
  id_chat     Int
  
  proyecto    proyecto @relation(fields: [id_proyecto], references: [id])
  chat        chat     @relation(fields: [id_chat], references: [id])
}

model leido {
  id Int @id @default(autoincrement())
  id_mensaje Int
  id_persona Int

  mensaje mensajes @relation(fields: [id_mensaje], references: [id])
  persona persona @relation(fields: [id_persona], references: [id])
  @@unique([id_mensaje, id_persona])
}

model ia_paginas {
  id    Int      @id @default(autoincrement())
  pagina_id Int
  name_archivo    String 
  archivo_codigo_pagina  String 
  lenguaje    String 
  foto_pagina_jpg   Bytes
  respuesta_ia    String?

    @@index([pagina_id])
}