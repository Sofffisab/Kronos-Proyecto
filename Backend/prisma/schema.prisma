generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persona {
  id        Int      @id @default(autoincrement())
  mail     String   @unique
  nombre  String
  contrasenia  String
  usuario  String   @unique
  foto_perfil   Bytes?
  horario_inicio        DateTime? @db.Time  
  horario_fin           DateTime? @db.Time

  archivos        archivos[]
  mensajes        mensajes[]
  personalizaciones personalizaciones[]
  proyectos_tiene tiene[]
  chat_tiene tiene_pc[]
  leido_mensajes     leido[]
  ia_paginas      ia_paginas[]

  googleRefreshToken String?

  tareas_responsable    tareas[] @relation("TareaResponsable")
  tareas_asignadas      tareas[] @relation("TareaAsignado")
  tareas_creadas    tareas[] @relation("TareaCreador")
  proyectos_creados proyecto[] @relation("ProyectoCreador")
}

model archivos {
  formato  String
  archivo   Bytes
  nombrearchivo   String     
  id    Int     @id @default(autoincrement())
  id_persona  Int
  id_proyecto   Int

  persona       persona  @relation(fields: [id_persona], references: [id], onDelete: Cascade)
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@unique([nombrearchivo, id_proyecto])
}

model mensajes {
  id_chat   Int
  id_persona    Int?
  mensaje   String
  estado    String
  id    Int     @id @default(autoincrement())
  fecha_envio DateTime @default(now())

  chat          chat     @relation(fields: [id_chat], references: [id], onDelete: Cascade)
  persona       persona?  @relation(fields: [id_persona], references: [id], onDelete: SetNull)

  leidopor leido[]
}

model tareas {
  nombre    String
  estado    String
  id    Int    @id @default(autoincrement())
  id_proyecto   Int
  id_creador    Int?
  id_responsable  Int?
  nombre_responsable  String?
  limite      DateTime
  eventId   String?
  importancia         String?  
  duracion    Int?
  orden               Int?
  id_asignado         Int?
  isKanban            Boolean @default(false)

  responsable         persona?  @relation("TareaResponsable", fields: [id_responsable], references: [id], onDelete: SetNull)
  proyecto            proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  creador             persona?  @relation("TareaCreador", fields: [id_creador], references: [id], onDelete: SetNull)
  asignado            persona?  @relation("TareaAsignado", fields: [id_asignado], references: [id], onDelete: SetNull)
}

model personalizaciones {
  id    Int     @id @default(autoincrement())
  id_persona    Int
  codigo_a_insertar   String

  persona             persona  @relation(fields: [id_persona], references: [id], onDelete: Cascade)
}

model tiene {
  id        Int      @id @default(autoincrement())
  id_persona  Int  
  id_proyecto   Int

  persona       persona  @relation(fields: [id_persona], references: [id], onDelete: Cascade)
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  @@unique([id_persona, id_proyecto])
}

model proyecto {
  id        Int      @id @default(autoincrement())
  nombre     String    
  limite     DateTime
  descripcion String?
  fechaInicio DateTime @default(now())
  fechaFin DateTime?
  creadorId Int?
  foto_perfil   Bytes?
  oficio    String?

  archivos        archivos[]
  tareas          tareas[]
  personas_tiene  tiene[]
  chats           chat[]
  invitaciones    invitaciones[]
  chats_tiene_rc  tiene_rc[]
  
  creador         persona? @relation("ProyectoCreador", fields: [creadorId], references: [id], onDelete: SetNull)
}

model invitaciones {
  id        Int      @id @default(autoincrement())
  id_proyecto Int
  mail      String
  codigo    String   @unique
  estado    String
  fechaEnvio DateTime @default(now())
  fechaExpiracion DateTime

  proyecto  proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
}

model chat {
  id        Int      @id @default(autoincrement())
  nombre     String    

  id_proyecto   Int
  proyecto      proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  mensajes      mensajes[]
  personas_tiene  tiene_pc[]
  tiene_rc      tiene_rc[]
}

model tiene_pc {
  id         Int      @id @default(autoincrement())
  id_persona Int
  id_chat    Int
   
  persona    persona  @relation(fields: [id_persona], references: [id], onDelete: Cascade)
  chat       chat     @relation(fields: [id_chat], references: [id], onDelete: Cascade)
  @@unique([id_persona, id_chat])
}

model tiene_rc {
  id          Int      @id @default(autoincrement())
  id_proyecto Int
  id_chat     Int
   
  proyecto    proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  chat        chat     @relation(fields: [id_chat], references: [id], onDelete: Cascade)
}

model leido {
  id Int @id @default(autoincrement())
  id_mensaje Int
  id_persona Int?

  mensaje mensajes @relation(fields: [id_mensaje], references: [id], onDelete: Cascade)
  persona persona? @relation(fields: [id_persona], references: [id], onDelete: SetNull)
  @@unique([id_mensaje, id_persona])
}

model ia_paginas {
  id              Int      @id @default(autoincrement())
  id_persona      Int
  pagina_id       Int
  language_map    Json
  codigo_json     Json
  imagen_jpg      Bytes
  tema            String
  respuesta_ia    String?

  persona         persona  @relation(fields: [id_persona], references: [id], onDelete: Cascade)
  @@index([pagina_id])
}